{
	if(!flagVisible)
	{
		//wxPoint pos = wxGetMousePosition();
	}
	this->Show(true);
	flagVisible = true;
}
void OPolyglotDialogTranslation::SetInvisible()
{
	this->Show(false);
	flagVisible = false;
}

void OPolyglotDialogTranslation::OnClose( wxCloseEvent& event )
{
	OPOLYGLOT_MESSAGE();
	SetInvisible();
}

void OPolyglotDialogTranslation::OnDone( wxCommandEvent& event ) 
{
	OPOLYGLOT_MESSAGE();
	SetInvisible();
}

void OPolyglotDialogTranslation::StartTranslation(wxString text)
{
	OPOLYGLOT_MESSAGE();
	SetVisible();
	if(filesYml->GetCount() == 0)
	{
		wxMessageDialog dialog(this,_T("not select language"),wxT("OPolyglot translator"),wxICON_ERROR|wxOK);
		dialog.ShowModal();
		return;
	}
	progress = new wxProgressDialog(wxT("OPolyglot"),_("Translating..."),100,this,wxPD_APP_MODAL);
	//progress->SetIcon(wxICON());
	progress->SetIcon(wxICON(icon));

	this->textOriginal->SetValue(wxString(text));
	progress->Show();
	timer->Start(500);
	fileNameImageForOCR = wxEmptyString;
	if (CreateThread(wxTHREAD_JOINABLE) != wxTHREAD_NO_ERROR)
    {
        OPOLYGLOT_ERROR(wxT("Could not create the worker thread!"));
        return;
    }
 
    // go!
    if (GetThread()->Run() != wxTHREAD_NO_ERROR)
    {
        OPOLYGLOT_ERROR(wxT("Could not run the worker thread!"));
        return;
    }
}


void OPolyglotDialogTranslation::StartOCRAndTranslation(wxString fileName)
{
	OPOLYGLOT_MESSAGE(wxT("%s"),fileName);
	SetVisible();
	progress = new wxProgressDialog(wxT("OPolyglot"),_("OCR and Translating..."),100,this,wxPD_APP_MODAL);
	progress->SetIcon(wxICON(icon));
	fileNameImageForOCR = fileName;
	progress->Show();
	timer->Start(500);
	if(CreateThread(wxTHREAD_JOINABLE) != wxTHREAD_NO_ERROR)
	{
		OPOLYGLOT_ERROR(wxT("Could not create the worker thread!"));
		return;
	}
	if(GetThread()->Run() != wxTHREAD_NO_ERROR)
	{
		OPOLYGLOT_ERROR(wxT("Could not run the worker thread!"));
		return;
	}
	//----;
}
