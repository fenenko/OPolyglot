void OPolyglotDialogTranslation::OnTimeUpdate(wxTimerEvent &event)
{
	//OPOLYGLOT_MESSAGE();
	if(progress != nullptr)
	{
		if(99 <= progress->GetValue())
		{
			progress->Update(0);
		} else
		{
			progress->Update(progress->GetValue()+1);
		}
	}
}

