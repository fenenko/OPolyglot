wxThread::ExitCode OPolyglotDialogTranslation::Entry()
{
	wxString original =wxEmptyString;
	if(!fileNameImageForOCR.IsEmpty())
	{
		OPOLYGLOT_MESSAGE(wxT("start OCR %s ..."),fileNameImageForOCR);
		this->textTranslation->SetValue(wxString(wxT("OCR...")));
		tesseract::TessBaseAPI *ocr = new tesseract::TessBaseAPI();
		int ret = ocr->Init(OPOLYGLOT_USER_DATA,*langOCR);
		if(0 != ret )
		{
			OPOLYGLOT_ERROR("tesseract init");
			timer->Stop();
			progress->~wxProgressDialog();
			progress = nullptr;
			return (wxThread::ExitCode)-1;

		}
		OPOLYGLOT_MESSAGE(wxT("tesseract->Init %d"),ret);
		Pix *image = pixRead(fileNameImageForOCR.utf8_str());
		wxThread::This()->Sleep(1000);
		ocr->SetImage(image);
		wxThread::This()->Sleep(1000);
		wxString str = wxString(ocr->GetUTF8Text(),wxConvUTF8);

		OPOLYGLOT_MESSAGE(wxT("label test 1"));
		//OPOLYGLOT_MESSAGE(wxT("%s"),str);
		original = str;
		this->textOriginal->SetValue(str);
		ocr->End();
		OPOLYGLOT_MESSAGE(wxT("OCR finish"));
		wxThread::This()->Sleep(1000);
		//wxMilliSleep(1000);
	} else
	{
		original = this->textOriginal->GetValue();
	}
	OPOLYGLOT_MESSAGE(wxT("start translating..."));
	//this->textTranslation->SetValue(wxString(wxT("translating...")));
	wxString result = original;
	for(size_t i =0; i < filesYml->GetCount();i++)
	{
		result = Translator::translate(result,wxString::Format(wxT("%s/%s"),OPOLYGLOT_USER_DATA,filesYml->Item(i)));
	}
/*
	wxString result = wxString(translator->translate(original));
	*/
	//this->textTranslation->SetValue(wxString(result));
	timer->Stop();
	progress->~wxProgressDialog();
	this->textTranslation->SetValue(result);
	progress = nullptr;
	OPOLYGLOT_MESSAGE(wxT("finish"));
	wxThreadEvent *event = new wxThreadEvent(wxEVT_COMMAND_OPOLYGLOT_TRANSLATE_COMPLETE);
	wxQueueEvent(this->parent, event);
	return (wxThread::ExitCode)0;
}





