{
	"app-id": "io.sourceforge.opolyglot",
	"runtime": "org.freedesktop.Platform",
	"runtime-version": "23.08",
	"sdk": "org.freedesktop.Sdk",
	"command": "opolyglot",
	"finish-args": [
		"--socket=x11",
		"--socket=wayland",
		"--share=network",
		"--env=DOWNLOAD_XML=/app/share/download.xml",
		"--env=ABOUT_HTML=/app/share/about.html",
		"--persist=.opolyglot"
	],
	"cleanup": [ "/include",
		"/lib/libtesseract.a",
		"/lib/libleptonica.a",
		"/lib/libpcre2-8.a",
		"/lib/libpcre2-posix.a",
		"/lib/debug/*",
		"/lib/debug",
		"/lib/cmake",
		"/lib/pkgconfig",
		"/lib/wx",
		"/bin/convertfilestopdf",
		"/bin/convertsegfilestops",
		"/bin/convertformat",
		"/bin/convertfilestops",
		"/bin/convertsegfilestopdf",
		"/bin/converttopdf",
		"/bin/converttops",
		"/bin/fileinfo",
		"/bin/imagetops",
	    "/bin/pcre2-config",
		"/bin/pcre2grep",
		"/bin/pcre2test",
		"/bin/tesseract",
		"/bin/wxrc-3.2",
		"/bin/xtractprotos",
		"/bin/wx-config",
		"/bin/wxrc",
		"/share/doc/pcre2"],
	"modules": [
		{
			"name": "tomcrypt",
			"buildsystem": "simple",
			"build-commands": [
				"make -f makefile.shared" ,
				"make -f makefile.shared PREFIX=$FLATPAK_DEST install"
			],
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/libtom/libtomcrypt",
					"commit": "7e7eb695d581782f04b24dc444cbfde86af59853"
				}
			]
		},
		{
			"name": "pcre2",
			"buildsystem": "cmake",
			"builddir": true,
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/PCRE2Project/pcre2",
					"commit": "f454e231fe5006dd7ff8f4693fd2b8eb94333429"
				}
			]
		},
		{
			"name": "leptonica",
			"buildsystem": "autotools",
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/danbloomberg/leptonica",
					"commit": "13275a278eb55b5746e33f95fbf5a2c8f604b3ab"
				}
			]
		},
		{
			"name": "tesseract",
			"buildsystem": "autotools",
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/tesseract-ocr/tesseract",
					"commit": "6e1d56a847e697de07b38619356550e5cf4e8633"

				}
			]
		},
		{
			"name": "openblas",
			"buildsystem": "cmake",
			"config-opts":[
				"-DCMAKE_BUILD_TYPE=Release",
				"-DDYNAMIC_ARCH=0",
				"-DBINARY=64", 
				"-DNO_AVX=1", 
				"-DNO_AVX2=1", 
				"-DUSE_THREAD=0", 
				"-DNO_AFFINITY=1", 
				"-DTARGET=CORE2", 
				"-DBUILD_SHARED_LIBS=ON", 
				"-DNOFORTRAN=1"
			],
			"builddir": true,
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/OpenMathLib/OpenBLAS",
					"commit": "76f1be470c9b9f80dc6e27407e13b975df436489"
				}
			]
		},
		{
			"name": "bergamot",
			"buildsystem": "simple",
			"build-commands": [
				"cmake ./",
				"make -j4",
				"cp -r ./inference/ /app/include/",
				"cp libmarian.so /app/lib",
				"cp ./inference/src/translator/libbergamot-translator-source.so /app/lib"


			],
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/mozilla/translations/",
					"commit": "c458f2fcb6dd6f890d92ff8272b548a35d1e5c64"
						
				},
				{
					"type": "patch",
					"path": "FlatpakInference.patch"
				}
			]
		},
		{
			"name": "wxWidgets",
			"buildsystem": "autotools",
			"config-opts": [
				"--with-gtk=3",
				"--with-cxx=17",
				"--with-libiconv=/usr"
			],
			"builddir": true,
			"sources": [
				{
					"type": "archive",
					"url": "https://github.com/wxWidgets/wxWidgets/releases/download/v3.2.10/wxWidgets-3.2.10.tar.bz2",
					"sha256": "d66e929569947a4a5920699539089a9bda83a93e5f4917fb313a61f0c344b896" 
				}
			]
		},
		{
			"name": "OPolyglot",
			"buildsystem": "simple",
			"build-commands":[
				"make clean",
				"make FLATPAK=1 build",
				"make FLATPAK=1 libtranslator",
				"cp ./bin/opolyglot /app/bin",
				"cp ./bin/libopolyglot-ocr-translator.so /app/lib",
				"mkdir -p /app/share/opolyglot",
				"cp ./res/download.xml /app/share/opolyglot",
				"cp ./res/about.html /app/share",
				"cp -r ./bin/locale /app"

					
			],
			"sources": [
			{
				"type": "dir",
				"path": "../../"
			}
			],
			"post-install":[
				"install -Dm644 ./src/io.sourceforge.opolyglot.desktop /app/share/applications/io.sourceforge.opolyglot.desktop",
				"install -Dm644 ./res/icon64.png /app/share/icons/hicolor/64x64/apps/io.sourceforge.opolyglot.png",
				"install -Dm644 ./src/io.sourceforge.opolyglot.metainfo.xml /app/share/metainfo/io.sourceforge.opolyglot.metainfo.xml"
			]
		}
		]
}
