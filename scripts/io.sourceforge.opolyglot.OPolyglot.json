{
	"app-id": "io.sourceforge.OPolyglot",
	"runtime": "org.freedesktop.Platform",
	"runtime-version": "23.08",
	"sdk": "org.freedesktop.Sdk",
	"command": "opolyglot",
	"finish-args": [
		"--socket=x11",
		"--socket=wayland",
		"--filesystem=host"
	],
	"cleanup": [ "/include" ],
	"modules": [
		{
			"name": "tomcrypt",
			"buildsystem": "simple",
			"build-commands": [
				"make -f makefile.shared" ,
				"make -f makefile.shared PREFIX=$FLATPAK_DEST install"
			],
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/libtom/libtomcrypt",
					"commit": "7e7eb695d581782f04b24dc444cbfde86af59853"
				}
			]
		},
		{
			"name": "pcre2",
			"buildsystem": "cmake",
			"builddir": true,
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/PCRE2Project/pcre2",
					"commit": "f454e231fe5006dd7ff8f4693fd2b8eb94333429"
				}
			]
		},
		{
			"name": "leptonica",
			"buildsystem": "autotools",
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/danbloomberg/leptonica",
					"commit": "13275a278eb55b5746e33f95fbf5a2c8f604b3ab"
				}
			]
		},
		{
			"name": "tesseract",
			"buildsystem": "autotools",
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/tesseract-ocr/tesseract",
					"commit": "6e1d56a847e697de07b38619356550e5cf4e8633"

				}
			]
		},
		{
			"name": "openblas",
			"buildsystem": "cmake",
			"builddir": true,
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/OpenMathLib/OpenBLAS",
					"commit": "76f1be470c9b9f80dc6e27407e13b975df436489"
				}
			]
		},
		{
			"name": "bergamot",
			"buildsystem": "cmake",
			"builddir": true,
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/mozilla/translations/",
					"commit": "20d1074529279afabbe546efe013f8e1fe80ee24"
						
				},
				{
					"type": "patch",
					"path": "FlatpakInference.patch"
				}
			]
		}
	]
}
