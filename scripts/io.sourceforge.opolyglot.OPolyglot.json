{
	"app-id": "io.sourceforge.OPolyglot",
	"runtime": "org.freedesktop.Platform",
	"runtime-version": "23.08",
	"sdk": "org.freedesktop.Sdk",
	"command": "OPolyglot",
	"finish-args": [
		"--socket=x11",
		"--socket=wayland",
		"--share=network",
		"--env=DOWNLOAD_XML=/app/share/download.xml",
		"--env=ABOUT_HTML=/app/share/about.html",
		"--persist=.OPolyglot"
	],
	"cleanup": [ "/include",
		"/lib/libtesseract.a",
		"/lib/libleptonica.a",
		"/lib/libopenblas.a",
		"/lib/libpcre2-8.a",
		"/lib/libpcre2-posix.a",
		"/lib/debug/*",
		"/lib/debug",
		"/lib/cmake",
		"/lib/pkgconfig",
		"/lib/wx",
		"/bin/convertfilestopdf",
		"/bin/convertsegfilestops",
		"/bin/convertformat",
		"/bin/convertfilestops",
		"/bin/convertsegfilestopdf",
		"/bin/converttopdf",
		"/bin/converttops",
		"/bin/fileinfo",
		"/bin/imagetops",
	    "/bin/pcre2-config",
		"/bin/pcre2grep",
		"/bin/pcre2test",
		"/bin/tesseract",
		"/bin/wxrc-3.2",
		"/bin/xtractprotos",
		"/bin/wx-config",
		"/bin/wxrc",
		"/share/doc/pcre2"],
	"modules": [
		{
			"name": "tomcrypt",
			"buildsystem": "simple",
			"build-commands": [
				"make -f makefile.shared" ,
				"make -f makefile.shared PREFIX=$FLATPAK_DEST install"
			],
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/libtom/libtomcrypt",
					"commit": "7e7eb695d581782f04b24dc444cbfde86af59853"
				}
			]
		},
		{
			"name": "pcre2",
			"buildsystem": "cmake",
			"builddir": true,
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/PCRE2Project/pcre2",
					"commit": "f454e231fe5006dd7ff8f4693fd2b8eb94333429"
				}
			]
		},
		{
			"name": "leptonica",
			"buildsystem": "autotools",
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/danbloomberg/leptonica",
					"commit": "13275a278eb55b5746e33f95fbf5a2c8f604b3ab"
				}
			]
		},
		{
			"name": "tesseract",
			"buildsystem": "autotools",
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/tesseract-ocr/tesseract",
					"commit": "6e1d56a847e697de07b38619356550e5cf4e8633"

				}
			]
		},
		{
			"name": "openblas",
			"buildsystem": "cmake",
			"builddir": true,
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/OpenMathLib/OpenBLAS",
					"commit": "76f1be470c9b9f80dc6e27407e13b975df436489"
				}
			]
		},
		{
			"name": "bergamot",
			"buildsystem": "simple",
			"build-commands": [
				"cmake ./",
				"make -j4",
				"cp -r ./inference/ /app/include/",
				"cp libmarian.so /app/lib",
				"cp ./inference/src/translator/libbergamot-translator-source.so /app/lib"


			],
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/mozilla/translations/",
					"_commit": "20d1074529279afabbe546efe013f8e1fe80ee24",
					"commit": "29389c687d1668e898b4b7dc3ca5a793aac75660"
						
				},
				{
					"type": "patch",
					"path": "FlatpakInference.patch"
				}
			]
		},
		{
			"name": "wxWidgets",
			"buildsystem": "autotools",
			"config-opts": [
				"--with-gtk=3",
				"--with-cxx=17",
				"--with-libiconv=/usr"
			],
			"builddir": true,
			"sources": [
				{
					"type": "archive",
					"url": "https://github.com/wxWidgets/wxWidgets/releases/download/v3.2.6/wxWidgets-3.2.6.tar.bz2",
					"sha256": "939e5b77ddc5b6092d1d7d29491fe67010a2433cf9b9c0d841ee4d04acb9dce7"
				}
			]
		},
		{
			"name": "OPolyglot",
			"buildsystem": "simple",
			"build-commands":[
				"make clean",
				"make FLATPAK=1 build",
				"make FLATPAK=1 libtranslator",
				"cp OPolyglot /app/bin",
				"cp ./bin/libopolyglot-ocr-translator.so /app/lib",
				"cp ./res/download.xml /app/share",
				"cp ./res/about.html /app/share",
				"cp -r ./locale /app"

					
			],
			"sources": [
			{
				"type": "dir",
				"path": "../"
			}
			]
		}
	]
}
